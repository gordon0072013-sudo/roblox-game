--!strict
--[[
	Generates `BrainrotLab_Installer.luau` — a single Luau script the user
	pastes into Roblox Studio's command bar. When run, it constructs every
	Folder, ModuleScript, LocalScript, and Script for the entire project
	with the correct Source, mirroring the Rojo `default.project.json`
	layout. Idempotent: re-runs replace existing instances.

	Run with Lune:  lune run tools/build_installer

	Or in any plain Luau 0.5+ runtime that has fs access (lune is easiest).
	Without Lune, see tools/build_installer.sh for a pure-shell fallback.
]]

local fs   = require("@lune/fs")
local proc = require("@lune/process")

local ROOT = proc.cwd

local function readFile(path: string): string
	return fs.readFile(path)
end

local function walk(dir: string): { string }
	local out = {}
	for _, entry in ipairs(fs.readDir(dir)) do
		local full = dir .. "/" .. entry
		local meta = fs.metadata(full)
		if meta.kind == "dir" then
			for _, sub in ipairs(walk(full)) do table.insert(out, sub) end
		elseif meta.kind == "file" then
			table.insert(out, full)
		end
	end
	return out
end

-- Build a manifest: { containerPath = "ReplicatedStorage/Shared", scripts = { ... } }
type ScriptEntry = {
	path: string,           -- dotted hierarchy under container, e.g. "Config" or "Brainrots/Patriarch"
	className: string,      -- ModuleScript / Script / LocalScript
	source: string,
}

local function scanDomain(srcDir: string): { ScriptEntry }
	local entries: { ScriptEntry } = {}
	local prefix = srcDir .. "/"
	for _, file in ipairs(walk(srcDir)) do
		if not (string.match(file, "%.luau$") or string.match(file, "%.lua$")) then
			continue
		end
		local rel = string.sub(file, #prefix + 1)
		local className = "ModuleScript"
		local cleanPath = rel
		if string.match(rel, "%.server%.luau$") then
			className = "Script"
			cleanPath = string.gsub(rel, "%.server%.luau$", "")
		elseif string.match(rel, "%.client%.luau$") then
			className = "LocalScript"
			cleanPath = string.gsub(rel, "%.client%.luau$", "")
		else
			cleanPath = string.gsub(rel, "%.luau$", "")
			cleanPath = string.gsub(cleanPath, "%.lua$", "")
		end
		local source = readFile(file)
		-- An `init` file becomes the container itself (rojo convention).
		if string.match(cleanPath, "/init$") or cleanPath == "init" then
			cleanPath = string.gsub(cleanPath, "/init$", "")
			if cleanPath == "init" then cleanPath = "" end
		end
		table.insert(entries, { path = cleanPath, className = className, source = source })
	end
	return entries
end

-- Long-bracket escape that's safe for any source: find the minimum number of
-- equals signs not present in the source.
local function safeLongBracket(source: string): string
	local n = 0
	while string.find(source, "%]" .. string.rep("=", n) .. "%]") do
		n += 1
		if n > 99 then error("Source contains absurd long-bracket sequences") end
	end
	return string.rep("=", n)
end

local function luaLiteral(source: string): string
	local eq = safeLongBracket(source)
	-- Leading newline keeps the long string clean and prevents the
	-- "long string starting with [[ then a shebang" parser quirk.
	return "[" .. eq .. "[\n" .. source .. "]" .. eq .. "]"
end

local domains = {
	{ container = "ReplicatedStorage", folder = "Shared",     srcDir = ROOT .. "/src/shared" },
	{ container = "ReplicatedStorage", folder = "Assets",     srcDir = ROOT .. "/src/assets", optional = true },
	{ container = "ServerScriptService", folder = "Server",   srcDir = ROOT .. "/src/server" },
	{ container = "StarterPlayer.StarterPlayerScripts", folder = "Client", srcDir = ROOT .. "/src/client" },
}

local lines: { string } = {}
local function emit(s: string) table.insert(lines, s) end

emit([[--!strict
-- BrainrotLab installer — generated by tools/build_installer.luau
-- Paste this entire file into Roblox Studio's Command Bar (View -> Command
-- Bar) and press Enter. The installer constructs every Folder, Script and
-- ModuleScript for the project into the correct Services. Re-running
-- replaces previously installed copies; do not run while playtesting.

local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then return existing end
	if existing then existing:Destroy() end
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function resolveContainer(path: string): Instance
	local cur: Instance = game
	for part in string.gmatch(path, "[^%.]+") do
		local next = cur:FindFirstChild(part)
		if not next then
			if cur == game then
				next = game:GetService(part)
			else
				next = Instance.new("Folder")
				next.Name = part
				next.Parent = cur
			end
		end
		cur = next
	end
	return cur
end

local function ensureScript(parent: Instance, name: string, className: string, source: string): Instance
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName ~= className then
		existing:Destroy()
		existing = nil
	end
	if not existing then
		existing = Instance.new(className)
		existing.Name = name
		existing.Parent = parent
	end
	(existing :: any).Source = source
	return existing
end

local function ensurePath(root: Instance, path: string, className: string, source: string)
	if path == "" then
		(root :: any).Source = source
		return
	end
	local segments = {}
	for seg in string.gmatch(path, "[^/]+") do table.insert(segments, seg) end
	local cur: Instance = root
	for i = 1, #segments - 1 do
		cur = ensureFolder(cur, segments[i])
	end
	ensureScript(cur, segments[#segments], className, source)
end

print("[BrainrotLab Installer] Beginning install...")
]])

for _, domain in ipairs(domains) do
	local exists = pcall(fs.metadata, domain.srcDir)
	if not exists and domain.optional then continue end

	emit(string.format("\ndo  -- %s/%s", domain.container, domain.folder))
	emit(string.format("\tlocal container = resolveContainer(%q)", domain.container))
	emit(string.format("\tlocal root = ensureFolder(container, %q)", domain.folder))

	local entries = scanDomain(domain.srcDir)
	-- Determine if there's an init script for the folder root (becomes the
	-- folder's source). For server bootstrap (init.server.luau) we'd
	-- normally promote the folder itself to a Script — but Folders can't
	-- run code, so emit an `init`-named Script under it instead and rely
	-- on Roblox's convention of running it on PlayerAdded via require.
	for _, entry in ipairs(entries) do
		local path = entry.path
		if path == "" then path = "init" end
		emit(string.format("\tensurePath(root, %q, %q, %s)", path, entry.className, luaLiteral(entry.source)))
	end
	emit("end")
end

emit([[

print("[BrainrotLab Installer] Install complete. Save the place file or press Play to test.")
]])

local output = ROOT .. "/BrainrotLab_Installer.luau"
fs.writeFile(output, table.concat(lines, "\n"))
print(string.format("Wrote %s (%d bytes)", output, #table.concat(lines, "\n")))
